# Copy to .env. Do not commit secrets.
# Hedera testnet x402 via Blocky402. Resource server never holds a facilitator key.

PORT=
# Public origin used to pin pay and as the default /docs curl host.
# Production: https://nametoll.run.place
PUBLIC_DESK_URL=
X402_NETWORK=
FACILITATOR_URL=
HEDERA_SELLER_ACCOUNT_ID=
HEDERA_SELLER_PRIVATE_KEY=
PRICE_TINYBARS=
HCS_TOPIC_ID=
MIRROR_NODE_URL=
# Subgraph Studio → API Keys (query key). Not a deploy key / Token API key.
GRAPH_GATEWAY_KEY=
GRAPH_GATEWAY_URL=

# Buyer signer (B2). Use the env key or a file path, not both required.
HEDERA_BUYER_ACCOUNT_ID=
HEDERA_BUYER_PRIVATE_KEY=
HEDERA_BUYER_KEY_PATH=

# CRE confidential secrets directory (B9). Desk must not log these.
CRE_SECRETS_PATH=
# Optional: live HTTP trigger URL, or the local cre/ project for simulate.
# Optional: live HTTP trigger. If unset, the desk uses CRE_PROJECT_DIR.
CRE_BRAIN_URL=
# Optional. Leave empty or set to cre. A laptop absolute path is ignored if ./cre exists.
CRE_PROJECT_DIR=
CRE_WORKFLOW_NAME=
CRE_TARGET=
# Same names as cre/.env. One copied .env is enough if these are set here.
CRE_ETH_PRIVATE_KEY=
SPEND_CAP_TINYBARS_VAR=
BUYER_ALLOWLIST_VAR=
RATE_LIMIT_VAR=

# ENSv2 Sepolia Omnigraph (B7). Do not put a name here — names are typed at resolve time.
ENSNODE_URL=
# Optional. Parent 2LD for POST /desk/register. Do not put a child name here.
ENS_PARENT=
# Public Sepolia addresses for unsigned ens-cli writes. Never put a private key here.
ENS_OWNER_ADDRESS=
ENS_OPERATOR_ADDRESS=
# Testnet-only Sepolia keys for npm run ens:sepolia. Never commit real values.
ACC_1_PRIV_KEY=
ACC3_PRIV_KEY=
ETH_RPC_URL=
# Optional. When set, POST /desk/pay requires this header (or the desk cookie on /app). GET inspect stays open.
DESK_PAY_SECRET=
# Optional. Fungible desk-credit token with a custom HBAR fee. Snapshot 402 stays native HBAR.
HTS_TOKEN_ID=

# Judging day: 30 minutes. Default in code is 60s. Keep-warm runs every TTL/2.
VERDICT_TTL_MS=1800000
# Guest faucet: 0.05 HBAR (50 one-unit snapshots). Floor 5 HBAR. Max 16 live guests.
GUEST_FAUCET_TINYBARS=5000000
GUEST_FAUCET_FLOOR_TINYBARS=500000000
GUEST_MAX_ACTIVE=16
