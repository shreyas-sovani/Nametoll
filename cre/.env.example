###############################################################################
### REQUIRED ENVIRONMENT VARIABLES - SENSITIVE INFORMATION                  ###
### Copy this file to `.env` (gitignored) and fill in real values.          ###
### DO NOT UPLOAD OR SHARE `.env` UNDER ANY CIRCUMSTANCES                   ###
###############################################################################
# Ethereum private key or 1Password reference (e.g. op://vault/item/field)
# Simulation of this verdict-only workflow does not broadcast. Keep this out of git.
CRE_ETH_PRIVATE_KEY=
# Default target used when --target is not specified
CRE_TARGET=staging-settings
# Value behind the SPEND_CAP secret in secrets.yaml. Fetched with
# runtime.getSecret({ id: 'SPEND_CAP' }) inside handlerInTee.
# Use a suffix that is not a prefix of the secret name (CRE CLI v1.1.0 bug).
SPEND_CAP_TINYBARS_VAR=
# Optional extra TEE axes. Empty = cap-only (existing allow/deny).
# Comma-separated Hedera account ids. Fetched with getSecret({ id: 'BUYER_ALLOWLIST' }).
BUYER_ALLOWLIST_VAR=
# Max pays per rolling hour. Fetched with getSecret({ id: 'RATE_LIMIT' }).
RATE_LIMIT_VAR=
